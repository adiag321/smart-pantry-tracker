# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key - server-only, never expose to the browser. Used by the
# admin client (src/lib/supabase/admin.ts) for every server-side query,
# including the manual product-entry route and the FIFO stored-procedure
# caller.
SUPABASE_SERVICE_ROLE_KEY=

# Shared single-user auth gate (Phase 1 note in PRD section 2 - no multi-user
# Supabase Auth needed). Pick any password; required to log into the app.
APP_SHARED_PASSWORD=

# Secret Vercel Cron sends as a Bearer token when it calls
# /api/cron/keep-alive (PRD section 5 - keeps the Supabase free-tier
# project from auto-pausing). Generate any random string; set the same
# value in Vercel's project environment variables.
CRON_SECRET=

# Recipe ingestion LLM fallback (PRD section 3B) - only used when a recipe
# page has no schema.org JSON-LD data. All optional and independent: set as
# many as you have free-tier keys for; each configured provider is tried in
# order (Groq, then Gemini, then OpenRouter, then NVIDIA NIM) until one
# succeeds. None set means extraction falls straight to the Readability
# text-based fallback.
# console.groq.com - verified working with model `openai/gpt-oss-120b`.
GROQ_API_KEY=
# aistudio.google.com/apikey - verified working with model `gemini-flash-lite-latest`.
GEMINI_API_KEY=
# openrouter.ai - OpenAI-compatible API, used via the `openai` SDK with a
# custom baseURL. Verified working with model `openrouter/free` (randomly
# routes across OpenRouter's free-tier pool).
OPENROUTER_API_KEY=
# build.nvidia.com (NVIDIA NIM) - also OpenAI-compatible via custom baseURL.
# NVIDIA grants invocation access per-model, not account-wide: a key works
# only for whichever model's page you clicked "Get API Key" from. Verified
# working with model `openai/gpt-oss-20b` specifically - other models
# (e.g. the Nemotron family) returned "Function not found for account" with
# this same key, even though they appear in this account's own /v1/models
# listing. If you want a different NVIDIA model, get a new key from that
# model's own page on build.nvidia.com rather than reusing this one.
NVIDIA_API_KEY=
# Optional model overrides - defaults are current free-tier-friendly models
# as of when this was written; override if a provider deprecates one.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENROUTER_MODEL=openrouter/free
# NVIDIA_MODEL=openai/gpt-oss-20b
